{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Lexicon entry, schema version 1 (bake-off draft, 2026-10-03)",
 "type": "object",
 "required": [
  "language",
  "headword",
  "lexemes"
 ],
 "additionalProperties": false,
 "properties": {
  "language": {
   "type": "string",
   "pattern": "^[a-z]{2}$"
  },
  "headword": {
   "type": "string",
   "minLength": 1
  },
  "lexemes": {
   "type": "array",
   "minItems": 0,
   "items": {
    "$ref": "#/$defs/lexeme"
   }
  },
  "reject": {
   "type": "string",
   "description": "Set, with lexemes empty, when the headword is not a lemma of the language: an abbreviation, a foreign word, an inflected form (name the lemma), a misspelling."
  }
 },
 "$defs": {
  "lexeme": {
   "type": "object",
   "required": [
    "lemma",
    "pos",
    "kind",
    "forms",
    "pronunciations",
    "senses"
   ],
   "additionalProperties": false,
   "properties": {
    "lemma": {
     "type": "string",
     "minLength": 1
    },
    "pos": {
     "type": "string",
     "enum": [
      "NOUN",
      "VERB",
      "ADJ",
      "ADV",
      "PRON",
      "DET",
      "ADP",
      "NUM",
      "CONJ",
      "SCONJ",
      "PART",
      "INTJ",
      "PROPN",
      "AUX"
     ]
    },
    "kind": {
     "type": "string",
     "enum": [
      "word",
      "phrase"
     ]
    },
    "grammar": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "boolean",
       "number"
      ]
     }
    },
    "forms": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/form"
     }
    },
    "pattern": {
     "type": "string"
    },
    "pronunciations": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/pronunciation"
     }
    },
    "senses": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/sense"
     }
    },
    "relations": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/relation"
     }
    }
   }
  },
  "form": {
   "type": "object",
   "required": [
    "form",
    "features"
   ],
   "additionalProperties": false,
   "properties": {
    "form": {
     "type": "string",
     "minLength": 1
    },
    "features": {
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "number"
      ]
     }
    },
    "ipa": {
     "type": "object",
     "additionalProperties": {
      "type": "string",
      "pattern": "^/.+/$"
     }
    }
   }
  },
  "pronunciation": {
   "type": "object",
   "required": [
    "variety",
    "ipa"
   ],
   "additionalProperties": false,
   "properties": {
    "variety": {
     "type": "string",
     "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "ipa": {
     "type": "string",
     "pattern": "^/.+/$"
    }
   }
  },
  "sense": {
   "type": "object",
   "required": [
    "definition",
    "glosses",
    "example",
    "cues",
    "cefr",
    "register"
   ],
   "additionalProperties": false,
   "properties": {
    "definition": {
     "type": "string",
     "minLength": 10
    },
    "pos_detail": {
     "type": "string"
    },
    "register": {
     "type": "string",
     "enum": [
      "neutral",
      "formal",
      "informal",
      "vulgar",
      "literary",
      "dated"
     ]
    },
    "cefr": {
     "type": "string",
     "enum": [
      "A1",
      "A2",
      "B1",
      "B2",
      "C1",
      "C2"
     ]
    },
    "glosses": {
     "type": "object",
     "additionalProperties": {
      "oneOf": [
       {
        "type": "string",
        "minLength": 1
       },
       {
        "type": "object",
        "required": [
         "text",
         "exact"
        ],
        "additionalProperties": false,
        "properties": {
         "text": {
          "type": "string",
          "minLength": 1
         },
         "exact": {
          "type": "boolean"
         }
        }
       }
      ]
     }
    },
    "example": {
     "type": "string",
     "minLength": 10
    },
    "cues": {
     "type": "array",
     "minItems": 2,
     "maxItems": 4,
     "items": {
      "type": "object",
      "required": [
       "kind",
       "text"
      ],
      "additionalProperties": false,
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "wording",
         "cloze"
        ]
       },
       "text": {
        "type": "string",
        "minLength": 6
       }
      }
     }
    }
   }
  },
  "relation": {
   "type": "object",
   "required": [
    "type",
    "lemma",
    "pos"
   ],
   "additionalProperties": false,
   "properties": {
    "type": {
     "type": "string",
     "enum": [
      "family",
      "confusable",
      "antonym"
     ]
    },
    "lemma": {
     "type": "string"
    },
    "pos": {
     "type": "string"
    },
    "why": {
     "type": "string"
    }
   }
  }
 }
}
