# Copy this file to .env. Defaults target the staging services through the
# SSH tunnels documented in docs/LOCAL_DEVELOPMENT.md.

# Application
SPRING_PROFILE=dev
LOCAL_PORT=8080
CONTEXT_PATH=/api/v1
DEBUG_PORT=5005

# PostgreSQL/PgBouncer staging tunnel
DB_HOST=127.0.0.1
DB_PORT=6432
DB_NAME=almonium_staging
DB_SCHEMA=public
DB_USERNAME=almonium_staging
DB_PASSWORD=replace-me

# RabbitMQ staging tunnel
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_USER=almonium_staging
RABBITMQ_PASS=replace-me
RABBITMQ_VHOST=/almonium_staging

# Google Cloud and Firebase
GOOGLE_PROJECT_ID=linguatool
FIREBASE_STORAGE_BUCKET=almonium.firebasestorage.app
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=replace-me

# Stream
STREAM_KEY=replace-me
STREAM_SECRET=replace-me

# Stripe
STRIPE_KEY=replace-me
STRIPE_WEBHOOK_SECRET=replace-me

# Email and dictionary providers
ZEPTO_API_KEY=replace-me
RAPID_API_KEY=replace-me
WORDNIK_KEY=replace-me
YANDEX_KEY=replace-me
