# Copy this file to .env. Defaults target the disposable local services in
# docker-compose.local.yaml.

# Application
SPRING_PROFILE=local
LOCAL_PORT=8080
CONTEXT_PATH=/api/v1
DEBUG_PORT=5005

# Local PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=almonium_local
DB_SCHEMA=public
DB_USERNAME=almonium
DB_PASSWORD=almonium-local

# Local RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_USER=almonium
RABBITMQ_PASS=almonium-local
RABBITMQ_VHOST=/almonium_local

# Google Cloud and Firebase
GOOGLE_PROJECT_ID=linguatool
FIREBASE_STORAGE_BUCKET=almonium.firebasestorage.app
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=replace-me

# Stream
STREAM_KEY=replace-me
STREAM_SECRET=replace-me

# Paddle Billing (use sandbox credentials and price IDs for local development)
PADDLE_ENVIRONMENT=SANDBOX
PADDLE_CLIENT_TOKEN=replace-me
PADDLE_API_KEY=replace-me
PADDLE_WEBHOOK_SECRET=replace-me
PADDLE_PRICE_PREMIUM_MONTHLY=pri_replace_me
PADDLE_PRICE_PREMIUM_ANNUAL=pri_replace_me
PADDLE_PRICE_FOUNDER_MONTHLY=pri_replace_me
PADDLE_PRICE_FOUNDER_ANNUAL=pri_replace_me

# Email and dictionary providers
ZEPTO_API_KEY=replace-me
RAPID_API_KEY=replace-me
WORDNIK_KEY=replace-me
YANDEX_KEY=replace-me

# Almonium Books publication hand-off
ALMONIUM_BOOKS_PUBLISHER_SECRET=replace-me
ALMONIUM_BOOKS_PROCESSOR_URL=http://localhost:8000/api/v1

# Chat with Almo
OPENAI_API_KEY=replace-me
# Ops spend page: an Admin API key from the OpenAI organisation settings, not a project key
OPENAI_ADMIN_KEY=replace-me
