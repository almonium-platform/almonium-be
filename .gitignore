# folders
target
temp
.idea
scripts/.venv
scripts/__pycache__

# files
*.iml
.env*
*.json
*.pyc

# Reviewed, non-secret voice routing shipped with the application.
!src/main/resources/tts-voices.json

# The entry schema the lexicon validates against, and the two real entries its tests publish.
!src/main/resources/lexicon/*.json
!src/test/resources/lexicon/*.json

# lexicon research: reviewed, non-secret data files are tracked; downloaded witness data and run output are not
!scripts/lexicon_research/*.json
!scripts/lexicon_research/inventories/*.json
!scripts/lexicon_research/headwords/*.json
scripts/lexicon_research/wikipron/
scripts/lexicon_research/out/
