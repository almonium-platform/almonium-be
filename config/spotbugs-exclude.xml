<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring injects these collaborators and JPA owns these entity associations. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
      FindSecBugs treats the server-resolved @Auth User as request mass assignment.
      ArchitectureTest rejects untrusted User parameters and all other JPA entities in controllers.
    -->
    <Match>
        <Bug pattern="ENTITY_MASS_ASSIGNMENT"/>
    </Match>

    <!-- Spring/JPA classes do not expose finalizers, so constructor validation cannot enable a finalizer attack. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Both logged values are strongly typed identifiers (UUID and Long), not raw request text. -->
    <Match>
        <Class name="com.almonium.learning.book.service.BookService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- The method builds reader markup only from values escaped with Spring's HtmlUtils. -->
    <Match>
        <Class name="com.almonium.learning.book.service.PublishedBookContentService"/>
        <Method name="appendParallelBlock"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>

    <!-- The typed entry is stripped of line breaks in loggable() before it reaches the log; the rest is an enum and an exception message. -->
    <Match>
        <Class name="com.almonium.analyzer.analyzer.service.DiscoverLookupService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Logged Almo values are a UUID and a closed enum, not raw request text. -->
    <Match>
        <Class name="com.almonium.learning.almo.service.AlmoChatService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Logged onboarding values are a UUID and a closed enum, not raw request text. -->
    <Match>
        <Class name="com.almonium.user.core.service.OnboardingService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

</FindBugsFilter>
